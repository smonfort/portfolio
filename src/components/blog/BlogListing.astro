---
import PostCard from '@components/blog/PostCard.astro';
import Pagination from '@components/blog/Pagination.astro';
import { useTranslations, getLangBase } from '@i18n/index';
import type { Lang } from '@i18n/index';
import type { CollectionEntry } from 'astro:content';
import type { Page } from 'astro';

interface Props {
  lang?: Lang;
  page: Page<CollectionEntry<'blogFr'> | CollectionEntry<'blogEn'>>;
}

const { lang = 'fr', page } = Astro.props;
const t = useTranslations(lang);
const base = getLangBase(lang);
const blogBase = `${base}/blog/`;

const posts = page.data;
---

<div class="mx-auto max-w-5xl px-6 py-20">
  <div class="mb-16">
    <h1 class="mb-4 text-4xl font-bold text-white sm:text-5xl">{t.blog.listHeading}</h1>
    <p class="text-lg text-gray-400">{t.blog.listDescription}</p>
  </div>

  {
    posts.length === 0 ? (
      <div class="py-20 text-center text-gray-500">
        <p>{t.blog.noArticles}</p>
      </div>
    ) : (
      <div class="grid gap-6 md:grid-cols-3">
        {posts.map((post) => (
          <PostCard
            href={`${base}/blog/${post.data.slug ?? post.id}`}
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            tags={post.data.tags}
            image={post.data.image}
            dateLocale={t.blog.dateLocale}
          />
        ))}
      </div>
    )
  }

  {
    page.lastPage > 1 && (
      <Pagination
        currentPage={page.currentPage}
        lastPage={page.lastPage}
        prevUrl={page.url.prev}
        nextUrl={page.url.next}
        baseUrl={blogBase}
        lang={lang}
      />
    )
  }
</div>
